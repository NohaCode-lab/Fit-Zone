# ==============================================================================
# FIT-ZONE PRODUCTION SAAS ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment & Server Settings
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=https://fit-zone.app

# Managed PostgreSQL Database with pgvector Extension
DATABASE_URL="postgresql://user:password@localhost:5432/fitzone_db?schema=public"

# Managed Redis Cache & Queue Store
REDIS_URL="redis://localhost:6379"

# Cryptographic & Authentication Secrets
JWT_SECRET="your_jwt_secret_key_here"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# AI Engine Integration
GEMINI_API_KEY="your_gemini_api_key_here"

# Commercial Stripe SaaS Billing Integration
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# Sentry Error Monitoring DSN
SENTRY_DSN="https://your_sentry_dsn_key@o000000.ingest.sentry.io/0000000"

# Frontend Client Public API Endpoint
VITE_API_BASE_URL=https://api.fit-zone.app/api/v1
